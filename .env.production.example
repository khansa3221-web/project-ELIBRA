# Salin menjadi ".env" di SERVER (jangan diunggah ke repository publik).
# Isi nilai yang bertanda <...> sesuai hosting kamu.
APP_NAME=E-LIBRA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<domain-kamu>
APP_KEY=
# APP_KEY dibuat di server dengan: php artisan key:generate --force

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Pilihan 1 (paling mudah): SQLite. Buat file kosong database/database.sqlite di server.
DB_CONNECTION=sqlite
# Pilihan 2: MySQL dari panel hosting
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=<nama_database>
# DB_USERNAME=<user_database>
# DB_PASSWORD=<password_database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12
